<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.6</version>
        <relativePath/>
    </parent>

    <groupId>com.attunedtechnology</groupId>
    <artifactId>verops-presence-webhook</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <!--
        WAR is named ROOT.war so Tomcat serves it at the root context path (/)
        with no renaming required on MochaHost.  The /verops prefix is part of
        the controller mapping, keeping the public URL unchanged:
        https://o11y.attunedtechnology.com/verops/demo/weekly-presence-report
    -->
    <packaging>war</packaging>
    <name>verops-presence-webhook</name>
    <description>Webhook receiver for VerOps weekly presence report — stores the report to the MochaHost filesystem</description>

    <properties>
        <java.version>17</java.version>
        <!-- ROOT.war → context path / on shared Tomcat; no rename needed on MochaHost -->
        <war.finalName>ROOT</war.finalName>
    </properties>

    <dependencies>
        <!-- Spring Boot web — embedded Tomcat excluded for WAR deployment -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Servlet API provided by the external Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${war.finalName}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
